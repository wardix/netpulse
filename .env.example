# ==========================================
# NetPulse Environment Configuration
# ==========================================

# --- Server & Core ---
PORT=3000
LOG_LEVEL=info
API_KEY=your-secret-api-key

# --- Database ---
# PostgreSQL (Primary):
# DATABASE_URL=postgres://user:password@localhost:5432/netpulse
# SQLite (Fallback if DATABASE_URL is not set):
DB_PATH=data/monitor.db

# --- Background Jobs & Worker Queue ---
ROGUE_CHECK_INTERVAL_MINUTES=10
DISPATCH_OPTRA_CONCURRENCY=5
DISPATCH_FIBERPULSE_CONCURRENCY=5
DISPATCH_POLL_INTERVAL_MS=200
DISPATCH_THROTTLE_DELAY_MS=50
DISPATCH_RETRY_BASE_DELAY_MS=3000
DISPATCH_JOB_MAX_AGE_MINUTES=120

# --- MikroTik Integration ---
MIKROTIK_TIMEOUT=5000

# --- NIS Gateway (Billing & FTTX Lookup) ---
NIS_IP_SEARCH_URL=https://nis-gateway.example.com/api/v1/ip-search
NIS_FTTX_BY_IP_URL=https://nis-gateway.example.com/api/v1/subscribers/fttx-by-ip
NIS_API_TOKEN=your-nis-bearer-token

# --- External FTTX Dispatch ---
# Operator ID 22 (Optra):
OPTRA_API_URL=https://optra-api.example.com/api/v1/subscribers/check
# Operator ID 1 (Fiberpulse):
FIBERPULSE_API_URL=https://fiberpulse-api.example.com/api/v1

# --- LOS Alert Webhook (WhatsApp / Alert Gateway) ---
LOS_WEBHOOK_URL=https://socket1.example.com/waenq/v2/messages
LOS_WEBHOOK_TOKEN=your-whatsapp-gateway-jwt-token
LOS_WEBHOOK_TO=6281234567890

# --- Seed Configuration (Optional) ---
SEED_ROUTER_1_ID=Mikrotik-Pusat
SEED_ROUTER_1_URL=http://192.168.88.1
SEED_ROUTER_1_USER=admin
SEED_ROUTER_1_PASS=your-router-password
